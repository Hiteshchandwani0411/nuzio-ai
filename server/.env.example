NODE_ENV=development
PORT=5000
MONGODB_URL=
# REQUIRED in production — set a strong random value. The server refuses to
# start when it is missing or still 'change-me'.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# News provider (optional — without a key the backend serves the bundled
# deterministic sample corpus so the product stays fully usable)
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsdata.io/api/1/latest?
NEWS_API_COUNTRY=in
NEWS_TIMEOUT_MS=6000
NEWS_PAGE_SIZE=20
NEWS_PERSONALIZED_LIMIT=12

# Audio (optional override; leave empty to let audio URLs follow the request origin)
AUDIO_BASE_URL=