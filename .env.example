# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nuzio
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# News provider (optional — without a key the backend serves the bundled
# deterministic sample corpus so the product stays fully usable)
NEWS_API_KEY=pub_YOUR_NEWSDATA_KEY
NEWS_API_BASE_URL=https://newsdata.io/api/1/latest
NEWS_API_COUNTRY=in
NEWS_API_LANGUAGE=en
NEWS_TIMEOUT_MS=6000
NEWS_PAGE_SIZE=20
NEWS_PERSONALIZED_LIMIT=12

# Client (copy to client/.env)
# VITE_API_URL=http://localhost:5000/api