# Base URL for the Nuzio API
# Development default — request /api via Vite's dev proxy to localhost:5000.
# Production: set this to your deployed API base URL before building
# (the host of your deployed Express API, followed by /api). If left unset,
# the client falls back to same-origin /api, which only works when the API
# and the client share an origin.
VITE_API_URL=http://localhost:5000/api